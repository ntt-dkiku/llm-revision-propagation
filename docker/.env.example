# Custom local LLM served by the generic vLLM compose (`make vllm-up` without
# MODEL). The five paper models have their own presets and ignore these values
# except VLLM_GPUS and VLLM_IMAGE (see README step 4). Example values below.
VLLM_HOST_PORT=8001
VLLM_MODEL=Qwen/Qwen3.5-27B
VLLM_SERVED_NAME=my-llm
VLLM_TENSOR_PARALLEL=1
VLLM_GPU_MEMORY_UTIL=0.90
VLLM_MAX_MODEL_LEN=65536
VLLM_DTYPE=bfloat16
VLLM_GPUS=0
VLLM_TOOL_PARSER=qwen3_coder
VLLM_REASONING_PARSER=qwen3
VLLM_IMAGE=vllm/vllm-openai:latest
HUGGINGFACE_HUB_TOKEN=
HF_HOME=${HOME}/.cache/huggingface

# Commercial-model API keys for litellm (only needed when MODEL is a commercial
# model, e.g. MODEL=openai/gpt-5.4-mini or MODEL=anthropic/claude-...). Local
# vLLM models need none; litellm reads whichever key matches the model's provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supply-chain cooldown (days). uv resolver rejects releases newer than (now - N days).
SUPPLY_CHAIN_COOLDOWN_DAYS=7
